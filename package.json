{
  "name": "mapscii",
  "version": "0.5.0",
  "description": "MapSCII is a Braille & ASCII world map renderer for your console, based on OpenStreetMap",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "bun run main.ts",
    "dev": "bun run --watch main.ts",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x eslint src main.ts",
    "test": "bun test",
    "build": "bun build main.ts --outdir ./dist --target node",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rastapasta/mapscii.git"
  },
  "bin": {
    "mapscii": "./bin/mapscii.js"
  },
  "files": [
    "bin/mapscii.js",
    "dist/",
    "styles/*.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "map",
    "console",
    "terminal",
    "ascii",
    "osm",
    "vectortile",
    "mbtiles"
  ],
  "author": "Michael Straßburger <codepoet@cpan.org>",
  "license": "MIT",
  "dependencies": {
    "@derhuerst/location": "^1.0.0",
    "@mapbox/vector-tile": "^2.0.4",
    "bresenham": "^0.0.4",
    "earcut": "^3.0.1",
    "ngeohash": "^0.6.3",
    "pbf": "^4.0.1",
    "rbush": "^4.0.1",
    "simplify-js": "^1.2.4",
    "string-width": "^8.1.0",
    "terminal-kit": "^3.1.2",
    "x256": "^0.0.2",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "wifi-triangulate": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "^1.1.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.3"
  }
}
